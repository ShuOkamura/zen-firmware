#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };

        scroll_combo {
            bindings = <&mo 4>;
            key-positions = <34 35>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESCAPE          &kp Q             &kp W     &kp E                    &kp R            &kp T              &kp Y        &kp U            &kp I       &kp O           &kp P            &kp DELETE
&kp TAB             &kp A             &kp S     &kp D                    &mt LSHIFT F     &kp G              &kp H        &mt RSHIFT J     &kp K       &kp L           &mt RCTRL MINUS  &kp ENTER
&kp LSHFT           &kp Z             &kp X     &kp C                    &kp V            &kp B              &kp LANG2    &kp LANG1        &kp N       &kp M           &mkp MB1         &mkp MB2         &kp UP_ARROW  &mt RSHFT QUESTION
&mt LCTRL LS(CAPS)  &kp LEFT_COMMAND  &kp LALT  &kp LS(INTERNATIONAL_1)  &mt LCTRL COMMA  &mt LSHIFT PERIOD  &lt 4 SPACE  &lt 2 BACKSPACE  &lt 3 RALT  &kp LEFT_ARROW  &kp DOWN_ARROW   &kp RIGHT_ARROW
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&kp ESCAPE  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)  &kp LS(N6)        &kp LS(N8)         &kp LS(N9)           &kp LS(N7)       &kp F8          &kp DELETE
&trans      &trans      &trans      &trans      &trans      &trans      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH        &kp LS(COMMA)    &kp LS(PERIOD)  &trans
&trans      &trans      &trans      &trans      &trans      &trans      &trans            &kp LS(LG(S))      &kp LA(PRINTSCREEN)  &kp PRINTSCREEN  &kp SLASH       &kp PERIOD  &kp INTERNATIONAL_3  &kp LS(INTERNATIONAL_3)
&trans      &trans      &trans      &trans      &trans      &trans      &trans            &trans             &trans               &trans           &trans          &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans      &trans             &trans        &trans             &kp LS(F5)  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3        &bt BT_SEL 4             &bt BT_CLR_ALL
&trans  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOL_UP  &kp LC(BACKSPACE)  &trans      &trans        &trans        &trans        &kp LG(L)           &trans                   &trans
&trans  &trans      &trans             &trans        &trans             &trans      &trans        &trans        &trans        &trans              &trans                   &kp LA(LEFT_ARROW)   &kp LS(LG(LEFT_ARROW))  &kp LA(RIGHT_ARROW)
&trans  &trans      &trans             &trans        &trans             &trans      &trans        &trans        &trans        &kp LG(LEFT_ARROW)  &kp LS(LG(RIGHT_ARROW))  &kp LG(RIGHT_ARROW)
            >;
        };

        layer_4 {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp LS(APOS)  &kp F8        &trans
&trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp LS(SEMI)  &kp APOS      &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans   &trans        &kp N0        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &kp LS(UNDERSCORE)  &trans
&trans  &trans   &trans   &trans  &trans  &trans   &trans        &trans        &trans        &trans        &trans        &trans
            >;
        };

        layer_5 {
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
